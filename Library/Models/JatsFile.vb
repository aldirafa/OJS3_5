Imports System.Text.Json
Imports System.Text.Json.Serialization
Imports Library.Serialization

Namespace Models

    ''' <summary>The JATS XML of a publication: either an uploaded source file or content generated by OJS.</summary>
    Partial Public Class JatsFile

        ''' <summary><c>true</c> when <c>jatsContent</c> was generated dynamically from publication metadata (because no JATS source file has been uploaded); <c>false</c> when it was read from an uploaded source file.</summary>
        Public Property IsDefaultContent As Boolean?

        ''' <summary>The JATS XML content. May be generated dynamically from publication metadata, or read from an uploaded source file.</summary>
        Public Property JatsContent As String

        ''' <summary>Present only if the JATS content could not be loaded. Contains a translated error message.</summary>
        Public Property LoadingContentError As String

        ''' <summary>
        ''' Properties returned by the server that this class does not model, such as those added by plugins
        ''' (<c>crossrefplugin::status</c>, <c>dataciteplugin::registeredDoi</c>, …).
        ''' </summary>
        <JsonExtensionData>
        Public Property AdditionalProperties As Dictionary(Of String, JsonElement)

    End Class

End Namespace
